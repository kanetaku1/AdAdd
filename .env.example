# AdAdd — docker-compose local environment
#
# Read by docker-compose.yml for variable substitution (${GOOGLE_CLIENT_ID}).
# Copy this file to .env and fill in the real value.

# Google OAuth client ID (same value as apps/web/.env's GOOGLE_CLIENT_ID).
# Required for POST /auth/google — without it, all Google login attempts
# fail with "google auth is not configured".
GOOGLE_CLIENT_ID=
