# AdAdd — docker-compose local environment
#
# Read by docker-compose.yml for variable substitution (${GOOGLE_CLIENT_ID}).
# Copy this file to .env and fill in the real value.

# Google OAuth client ID (same value as apps/web/.env's GOOGLE_CLIENT_ID).
# Required for POST /auth/google — without it, all Google login attempts
# fail with "google auth is not configured".
GOOGLE_CLIENT_ID=

# Slack mention when sponsorship progress becomes Confirmed (UC-16).
# docker compose injects these into the api container. Optional — omit both
# to disable sending. Running `go run` from apps/api uses apps/api/.env instead.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Signs session JWTs. Required — docker compose refuses to start the API
# without it. Any long random value works locally (openssl rand -base64 48).
# Production uses its own value in .env.production (spec/operations.md).
JWT_SECRET=

# Drive folder for ad material files (same value as apps/web/.env).
GOOGLE_DRIVE_ROOT_FOLDER_ID=
