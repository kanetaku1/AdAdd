# AdAdd — production settings for compose.production.yml
# (spec/operations.md#Production Configuration)
#
# Copy to .env.production (gitignored) and fill in. Never commit the filled file:
# the repository is public. Generate every secret below with, for example,
#   openssl rand -base64 48

# Database (created by the MySQL container on its first start)
DB_NAME=adadd_prod
DB_USER=adadd_prod
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Signs session JWTs. A long random value of its own — never the development one.
JWT_SECRET=

# Origin of the production web app, e.g. https://adadd.example.org
ALLOWED_ORIGINS=

# Google OAuth client ID (same value as the web app's GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# How migrations are applied: see spec/operations.md#Start the API against it.
# Defaults to false in compose.production.yml.
# MIGRATE_ON_START=

# Optional
GOOGLE_DRIVE_ROOT_FOLDER_ID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
