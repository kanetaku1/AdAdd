APP_PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=adadd
DB_PASSWORD=adadd_password
DB_NAME=adadd

# Slack mention when YearlyCompany.progress becomes CONFIRMED (UC-16).
# Used when running the API with `go run` (godotenv loads this file).
# docker compose does NOT read this file — put the same keys in the repo-root
# .env instead (see docker-compose.yml). Both must be set or sending is a no-op.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
