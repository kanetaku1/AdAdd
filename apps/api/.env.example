APP_PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=adadd
DB_PASSWORD=adadd_password
DB_NAME=adadd

# Signs session JWTs. Required in every environment — the API refuses to
# start without it. Any long random value works locally (openssl rand -base64 48).
JWT_SECRET=

# Verifies Google id_tokens on POST /auth/google (same value as apps/web/.env).
GOOGLE_CLIENT_ID=

# Dedicated Google Workspace account OAuth credentials (ADR-0006).
# GOOGLE_DRIVE_CLIENT_ID defaults to GOOGLE_CLIENT_ID when omitted.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ACCOUNT_EMAIL=

# Drive folder for ad material files.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Slack mention when YearlyCompany.progress becomes CONFIRMED (UC-16).
# Used when running the API with `go run` (godotenv loads this file).
# docker compose does NOT read this file — put the same keys in the repo-root
# .env instead (see docker-compose.yml). Both must be set or sending is a no-op.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
