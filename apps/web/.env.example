# AdAdd Web — local environment

# Backend API base URL.
# - Set: API mode — MySQL/API only. Failures surface as errors (no mock fallback).
# - Unset/empty: mock mode — in-memory mock data for local UI development.
# Example: NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# When "true", the /login redirect guard (src/middleware.ts) is bypassed and
# apiFetch's dev-stub X-User-ID/X-User-Roles headers keep working without a
# real Google login — mirrors the backend's DEV_AUTH_ENABLED. Leave unset
# (or "false") to exercise the real login flow.
NEXT_PUBLIC_DEV_AUTH_ENABLED=true

# Google OAuth 2.0 client (spec/api.md#Login). Server-only — never exposed to
# the browser. Get these from the shared AdAdd Google Cloud project's OAuth
# client (see project handoff docs, not committed here).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
