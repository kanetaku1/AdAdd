# AdAdd Web — local environment (spec/development.md#Development Modes)
#
# Mock mode: `npm run dev:mock` — ignores NEXT_PUBLIC_API_BASE_URL below and
#   runs on in-memory mock data. Sign in by choosing a Role's User on /login.
# MySQL mode: `npm run dev` with the API running — sign in with Google.

# Backend API base URL.
# - Set: API mode — MySQL/API only. Failures surface as errors (no mock fallback).
# - Unset/empty: mock mode (what `npm run dev:mock` does). Do not set this on
#   the Vercel deployment — it is a mock-only preview (spec/decisions/0002-deployment.md).
# Use 127.0.0.1 (not localhost) on Windows — Node fetch + Docker IPv6
# (localhost → ::1) often fails with ECONNRESET.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080

# Google OAuth 2.0 client (spec/api.md#Login). Server-only — never exposed to
# the browser. Get these from the shared AdAdd Google Cloud project's OAuth
# client (see project handoff docs, not committed here). Your Google account
# must be a test user of that client and a registered AdAdd User.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Drive Picker (exposed to the browser by next.config.ts).
GOOGLE_API_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
